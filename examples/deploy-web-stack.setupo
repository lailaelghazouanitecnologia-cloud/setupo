# Example: Deploy a web stack with setupo protocol
# This creates a web server MicroVM and a database VM

# Create instances
CREATE microvm "web-frontend" vcpus=1 memory=512
CREATE microvm "api-server" vcpus=2 memory=1024
CREATE vm "postgres-db" vcpus=4 memory=2048 disk=8192

# Install capsules
CAPSULE "web-frontend" load "nginx-proxy"
CAPSULE "api-server" load "python-app"

# Configure the API server
EXEC "api-server" run "pip install fastapi uvicorn psycopg2-binary"

# Connect instances
CONNECT "web-frontend" -> "api-server" port=8080
CONNECT "api-server" -> "postgres-db" port=5432

# List running instances
LIST microvms
LIST vms
