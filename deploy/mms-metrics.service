[Unit]
Description=MMS Metrics — Installation progress tracker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mms/mms-metrics
EnvironmentFile=/opt/mms/.env
Environment=MMS_METRICS_HOST=0.0.0.0
Environment=MMS_METRICS_PORT=8081
ExecStart=/opt/mms/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
