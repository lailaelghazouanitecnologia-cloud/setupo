[Unit]
Description=Setupo Agent — File/Exec/Metrics Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/setupo/mms-metrics
EnvironmentFile=/opt/setupo/.env
ExecStart=/opt/setupo/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
