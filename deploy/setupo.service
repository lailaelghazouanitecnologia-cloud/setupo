[Unit]
Description=Setupo — AI Agent Infrastructure API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/setupo
EnvironmentFile=/opt/setupo/.env
ExecStart=/opt/setupo/venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
