[Unit]
Description=MMS - Micro Module System
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mms
Environment=PATH=/opt/mms/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=MMS_TOKEN_PATH=/etc/mms/token
ExecStart=/opt/mms/venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
