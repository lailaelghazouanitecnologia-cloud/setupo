# MMS — Environment variables

# Vultr API (required for instance provisioning)
VULTR_API_KEY=your_vultr_api_key_here

# Cloudflare API (optional — for automatic DNS management)
# Users can also provide their own CF token per-project
CF_API_TOKEN=

# Server
MMS_HOST=0.0.0.0
MMS_PORT=8000
MMS_CORS_ORIGINS=https://zarnetti.com,http://localhost:3000

# Data paths
MMS_DATA_DIR=/opt/mms/data
MMS_CONFIG_DIR=/opt/mms/config

# Metrics
MMS_METRICS_URL=http://127.0.0.1:8081

# Admin
MMS_ADMIN_EMAIL=ayman_gha@hotmail.com
