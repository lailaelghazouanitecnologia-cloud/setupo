# Setupo — Environment variables

# Vultr API (required for instance provisioning)
VULTR_API_KEY=your_vultr_api_key_here

# Cloudflare API (optional — for automatic DNS management)
# Users can also provide their own CF token per-project
CF_API_TOKEN=

# Server
SETUPO_HOST=0.0.0.0
SETUPO_PORT=8000
SETUPO_CORS_ORIGINS=https://zarnetti.com,http://localhost:3000

# Data paths
SETUPO_DATA_DIR=/opt/setupo/data
SETUPO_CONFIG_DIR=/opt/setupo/config

# Admin
SETUPO_ADMIN_EMAIL=ayman_gha@hotmail.com
