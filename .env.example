# NSO — Environment variables

# ── Vultr API (required for instance provisioning) ──
VULTR_API_KEY=your_vultr_api_key_here
VULTR_DEFAULT_REGION=ewr
VULTR_DEFAULT_PLAN=vc2-1c-1gb
VULTR_DEFAULT_OS=2136

# ── Cloudflare API (optional — for automatic DNS management) ──
CF_API_TOKEN=
CF_NSO_ZONE_ID=
NSO_BASE_DOMAIN=nso.dev

# ── Cloudflare R2 (for .zar package storage) ──
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nso
R2_PUBLIC_URL=

# ── Central Server ──
SETUPO_HOST=0.0.0.0
SETUPO_PORT=8000
SETUPO_CORS_ORIGINS=https://nso.dev,http://localhost:3000

# ── Data paths ──
SETUPO_DATA_DIR=/opt/setupo/data
SETUPO_CONFIG_DIR=/opt/setupo/config
SETUPO_WORKSPACES_DIR=/opt/setupo/workspaces

# ── Admin auth ──
SETUPO_ADMIN_EMAIL=admin@example.com
SETUPO_ADMIN_PASSWORD=changeme

# ── Agent auth (used by central server to authenticate with VPS agents) ──
AGENT_ADMIN_PASSWORD=changeme
NSO_ADMIN_EMAIL=admin@example.com

# ── JWT (auto-generated if not set — set in production for token persistence across restarts) ──
# SETUPO_JWT_SECRET=

# ── Email (optional — emails are no-op if SMTP_HOST is empty) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=nso@nso.dev
# SETUPO_EMAIL_SECRET=           # Auto-generated if not set

# ── Stripe (optional — for paid billing plans) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ── Agent config (on the VPS itself) ──
# NSO_JWT_SECRET=           # Auto-generated if not set
# NSO_ALLOWED_DIRS=/opt/app # Comma-separated dirs the agent can write to
