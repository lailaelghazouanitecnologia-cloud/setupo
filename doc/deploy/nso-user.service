[Unit]
Description=NSO — User Server (user mode)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nso
EnvironmentFile=/opt/nso/.env
Environment=NSO_SERVER_MODE=user
ExecStart=/opt/nso/venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
