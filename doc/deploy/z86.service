[Unit]
Description=z86 — Self-hosted Object Storage
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nso
EnvironmentFile=/opt/nso/.env
ExecStart=/opt/nso/venv/bin/uvicorn z86.main:app --host 127.0.0.1 --port 8082 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
