[Unit]
Description=NSO Agent — VPS management service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nso/instance
EnvironmentFile=/opt/nso/.env
ExecStart=/opt/nso/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
