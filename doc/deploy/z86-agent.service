[Unit]
Description=z86 Agent — Remote Management
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nso/z86/agent
EnvironmentFile=/opt/nso/.env
ExecStart=/opt/nso/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8083
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
